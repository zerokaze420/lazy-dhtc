FROM node:20-bookworm AS css-builder
WORKDIR /build
COPY package*.json ./
RUN npm install
COPY ui ./ui
COPY tailwind.config.js ./
RUN npm run build

FROM golang:1.25-bookworm AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=css-builder /build/ui/static/css/style.css ./ui/static/css/style.css
COPY --from=css-builder /build/ui/static/js/lazycat-notifications.js ./ui/static/js/lazycat-notifications.js
RUN CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/dhtc ./cmd/dhtc

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go-builder /out/dhtc /usr/local/bin/dhtc
COPY bootstrap-nodes.txt name-blacklist.txt file-blacklist.txt /usr/local/share/dhtc/
EXPOSE 4200
CMD ["dhtc", "-address", "0.0.0.0:4200", "-database", "/lzcapp/var/dhtcdb", "-BootstrapNodeFile", "/usr/local/share/dhtc/bootstrap-nodes.txt", "-RoutingTableCacheIPv4", "/lzcapp/var/routing-table-v4.json", "-RoutingTableCacheIPv6", "/lzcapp/var/routing-table-v6.json"]
